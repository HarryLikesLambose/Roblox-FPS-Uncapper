import argparse
import os
import platform
import shutil
import tempfile
import xml.etree.ElementTree as ET

# Configuration
FRAMERATE_CAP = 9999


def get_default_settings_path():
    """
    Determines the default path to GlobalBasicSettings_13.xml
    based on the operating system.
    """
    system = platform.system()

    if system == "Windows":
        local_app_data = os.environ.get("LOCALAPPDATA")

        if not local_app_data:
            user_profile = os.environ.get("USERPROFILE")

            if not user_profile:
                raise OSError(
                    "Could not determine the Windows user profile directory."
                )

            local_app_data = os.path.join(
                user_profile,
                "AppData",
                "Local"
            )

        return os.path.join(
            local_app_data,
            "Roblox",
            "GlobalBasicSettings_13.xml"
        )

    elif system == "Linux":
        # Path for Sober on Linux
        return os.path.expanduser(
            "~/.var/app/org.vinegarhq.Sober/data/Sober/appData/"
            "GlobalBasicSettings_13.xml"
        )

    else:
        raise OSError(
            f"Unsupported operating system: {system}"
        )


def indent(elem, level=0):
    """
    Helper function to pretty-print XML for older Python versions
    that don't support ET.indent.
    """
    i = "\n" + level * "\t"

    if len(elem):
        if not elem.text or not elem.text.strip():
            elem.text = i + "\t"

        if not elem.tail or not elem.tail.strip():
            elem.tail = i

        for child in elem:
            indent(child, level + 1)

        if not child.tail or not child.tail.strip():
            child.tail = i

    else:
        if level and (
            not elem.tail or not elem.tail.strip()
        ):
            elem.tail = i


def safe_save(tree, target_path):
    """
    Safely saves the XML.

    1. Creates a backup.
    2. Writes the new XML to a temporary file.
    3. Flushes it to disk.
    4. Atomically replaces the original file.
    """

    backup_path = target_path + ".bak"
    temp_path = None

    try:
        # Backup the original settings file
        shutil.copy2(target_path, backup_path)

        folder = os.path.dirname(
            os.path.abspath(target_path)
        )

        # Create temporary file in the SAME directory.
        # This helps ensure os.replace() is atomic.
        with tempfile.NamedTemporaryFile(
            mode="wb",
            delete=False,
            dir=folder,
            prefix="GlobalBasicSettings_",
            suffix=".tmp",
        ) as temp_file:

            temp_path = temp_file.name

            tree.write(
                temp_file,
                encoding="utf-8",
                xml_declaration=True
            )

            # Force Python's buffered data to be written
            temp_file.flush()

            # Ask the OS to flush it to the drive
            os.fsync(temp_file.fileno())

        # Atomically replace the original
        os.replace(temp_path, target_path)

        print("File saved successfully.")
        print(f"Backup created: {backup_path}")

        return True

    except Exception as e:
        print(f"Error saving file: {e}")

        # Clean up temporary file if something failed
        if (
            temp_path
            and os.path.exists(temp_path)
        ):
            try:
                os.remove(temp_path)
            except OSError:
                pass

        return False


def main():
    parser = argparse.ArgumentParser(
        description="Safely set Roblox FPS Cap"
    )

    parser.add_argument(
        "file_path",
        nargs="?",
        help="Path to GlobalBasicSettings_13.xml",
        default=None,
    )

    args = parser.parse_args()

    if args.file_path:
        target_path = os.path.abspath(
            os.path.expanduser(args.file_path)
        )

    else:
        try:
            target_path = get_default_settings_path()

        except OSError as e:
            print(f"Error: {e}")
            return

    print(f"Target file path: {target_path}")

    if not os.path.isfile(target_path):
        print(
            "Error: The settings file does not exist.\n"
            "Run Roblox/Sober at least once or provide "
            "the correct path."
        )
        return

    try:
        # Parse existing XML
        tree = ET.parse(target_path)
        root = tree.getroot()

    except ET.ParseError as e:
        print(f"Error parsing XML file: {e}")
        print("The original file has NOT been modified.")
        return

    except Exception as e:
        print(f"Error reading file: {e}")
        return

    # Find UserGameSettings
    user_game_settings = None

    for item in root.findall("Item"):
        if item.get("class") == "UserGameSettings":
            user_game_settings = item
            break

    if user_game_settings is None:
        print(
            "Error: Could not find "
            "'UserGameSettings' in the XML file."
        )
        return

    # Find Properties
    properties = user_game_settings.find("Properties")

    if properties is None:
        print("Creating Properties element...")
        properties = ET.SubElement(
            user_game_settings,
            "Properties"
        )

    # Find FramerateCap
    framerate_node = None

    for child in properties:
        if child.get("name") == "FramerateCap":
            framerate_node = child
            break

    if framerate_node is not None:
        print(
            "Found existing FramerateCap. "
            f"Current value: {framerate_node.text}"
        )

        framerate_node.text = str(
            FRAMERATE_CAP
        )

        print(
            f"Updated FramerateCap to: "
            f"{FRAMERATE_CAP}"
        )

    else:
        print(
            "FramerateCap not found. "
            f"Creating it with value: "
            f"{FRAMERATE_CAP}"
        )

        framerate_node = ET.SubElement(
            properties,
            "int"
        )

        framerate_node.set(
            "name",
            "FramerateCap"
        )

        framerate_node.text = str(
            FRAMERATE_CAP
        )

    # Pretty-print XML
    if hasattr(ET, "indent"):
        ET.indent(
            tree,
            space="\t",
            level=0
        )
    else:
        indent(root)

    # Safely save
    safe_save(
        tree,
        target_path
    )


if __name__ == "__main__":
    main()
